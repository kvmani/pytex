{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pytex.parity_case_campaign",
  "title": "PyTex External Parity Case Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "campaign_id",
    "title",
    "target_baseline",
    "conventions",
    "cases"
  ],
  "properties": {
    "schema_id": { "const": "pytex.parity_case_campaign" },
    "schema_version": { "const": "0.1.0" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "target_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "version", "release_date", "reference_url"],
      "properties": {
        "system": { "const": "mtex" },
        "version": { "type": "string", "minLength": 1 },
        "release_date": { "type": "string", "minLength": 1 },
        "reference_url": { "type": "string", "minLength": 1 }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "euler_convention",
        "angles_unit",
        "quaternion_order",
        "matrix_storage",
        "orientation_mapping",
        "rotation_sense"
      ],
      "properties": {
        "euler_convention": { "type": "string", "minLength": 1 },
        "angles_unit": { "enum": ["degree", "radian"] },
        "quaternion_order": { "const": "wxyz" },
        "matrix_storage": { "const": "row_major" },
        "orientation_mapping": { "type": "string", "minLength": 1 },
        "rotation_sense": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "operation_family",
          "operation",
          "phase",
          "input",
          "requested_outputs",
          "tolerances"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "pending"] },
          "reason_pending": { "type": "string" },
          "operation_family": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "phase": {
            "type": "object",
            "additionalProperties": true,
            "required": ["phase_id", "crystal_system", "point_group", "lattice_parameters"],
            "properties": {
              "phase_id": { "type": "string", "minLength": 1 },
              "crystal_system": { "type": "string", "minLength": 1 },
              "point_group": { "type": "string", "minLength": 1 },
              "lattice_parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["a", "b", "c", "alpha", "beta", "gamma", "unit"],
                "properties": {
                  "a": { "type": "number", "exclusiveMinimum": 0 },
                  "b": { "type": "number", "exclusiveMinimum": 0 },
                  "c": { "type": "number", "exclusiveMinimum": 0 },
                  "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
                  "beta": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
                  "gamma": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
                  "unit": { "const": "angstrom_degree" }
                }
              }
            }
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "requested_outputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "tolerances": {
            "type": "object",
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
