{
  "schema_id": "pytex.parity_case_campaign",
  "schema_version": "0.1.0",
  "campaign_id": "xrdml_pole_figure_v1",
  "title": "XRDML pole figure import and export parity",
  "description": "Pending cases for cubic and hexagonal XRDML pole figure import, semantic export, and figure artifact generation. Activate these after the real test files are added.",
  "target_baseline": {
    "system": "mtex",
    "version": "6.0.0",
    "release_date": "November 2024",
    "reference_url": "https://mtex-toolbox.github.io/download"
  },
  "conventions": {
    "euler_convention": "bunge_zxz",
    "angles_unit": "degree",
    "quaternion_order": "wxyz",
    "matrix_storage": "row_major",
    "orientation_mapping": "crystal_to_specimen",
    "rotation_sense": "active",
    "pole_figure_normalization": "mean_one",
    "specimen_axes": ["RD", "TD", "ND"],
    "crystal_axes": ["a", "b", "c"]
  },
  "cases": [
    {
      "case_id": "cubic_xrdml_pole_figure_pending",
      "status": "pending",
      "reason_pending": "Waiting for a cubic XRDML pole-figure fixture file.",
      "operation_family": "pole_figure",
      "operation": "pole_figure_from_xrdml",
      "phase": {
        "phase_id": "cubic_phase_pending",
        "crystal_system": "cubic",
        "point_group": "m-3m",
        "lattice_parameters": {
          "a": 3.52,
          "b": 3.52,
          "c": 3.52,
          "alpha": 90.0,
          "beta": 90.0,
          "gamma": 90.0,
          "unit": "angstrom_degree"
        }
      },
      "input": {
        "xrdml_path": "fixtures/xrdml/cubic_case_to_be_added.xrdml",
        "pole_hkl": [1, 1, 1],
        "intensity_normalization": "mean_one"
      },
      "requested_outputs": [
        "alpha_deg",
        "beta_deg",
        "sample_directions",
        "intensity_grid",
        "normalization",
        "pole_figure_svg"
      ],
      "tolerances": {
        "angle_deg": 1e-6,
        "intensity_relative": 0.05,
        "vector_abs": 1e-8
      },
      "notes": [
        "The schema and scripts already support this shape; replace the path and status when the fixture lands."
      ]
    },
    {
      "case_id": "hex_xrdml_pole_figure_pending",
      "status": "pending",
      "reason_pending": "Waiting for a hexagonal XRDML pole-figure fixture file.",
      "operation_family": "pole_figure",
      "operation": "pole_figure_from_xrdml",
      "phase": {
        "phase_id": "hex_phase_pending",
        "crystal_system": "hexagonal",
        "point_group": "6/mmm",
        "lattice_parameters": {
          "a": 3.23,
          "b": 3.23,
          "c": 5.15,
          "alpha": 90.0,
          "beta": 90.0,
          "gamma": 120.0,
          "unit": "angstrom_degree"
        }
      },
      "input": {
        "xrdml_path": "fixtures/xrdml/hex_case_to_be_added.xrdml",
        "pole_hkil": [1, 0, -1, 0],
        "intensity_normalization": "mean_one"
      },
      "requested_outputs": [
        "alpha_deg",
        "beta_deg",
        "sample_directions",
        "intensity_grid",
        "normalization",
        "pole_figure_svg"
      ],
      "tolerances": {
        "angle_deg": 1e-6,
        "intensity_relative": 0.05,
        "vector_abs": 1e-8
      },
      "notes": [
        "The schema and scripts already support this shape; replace the path and status when the fixture lands."
      ]
    }
  ]
}
