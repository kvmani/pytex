{
  "schema_id": "pytex.parity_case_campaign",
  "schema_version": "0.1.0",
  "campaign_id": "ipf_color_v1",
  "title": "IPF color parity",
  "description": "Shared MTEX/PyTex cases for IPF color calculations from Euler orientations.",
  "target_baseline": {
    "system": "mtex",
    "version": "6.0.0",
    "release_date": "November 2024",
    "reference_url": "https://mtex-toolbox.github.io/download"
  },
  "conventions": {
    "euler_convention": "bunge_zxz",
    "angles_unit": "degree",
    "quaternion_order": "wxyz",
    "matrix_storage": "row_major",
    "orientation_mapping": "crystal_to_specimen",
    "rotation_sense": "active",
    "color_space": "srgb_0_1",
    "specimen_axes": ["RD", "TD", "ND"],
    "crystal_axes": ["a", "b", "c"]
  },
  "cases": [
    {
      "case_id": "cubic_ipf_nd_colors_001",
      "status": "active",
      "operation_family": "ipf_color",
      "operation": "ipf_colors_from_euler",
      "phase": {
        "phase_id": "ni_fcc",
        "crystal_system": "cubic",
        "point_group": "m-3m",
        "lattice_parameters": {
          "a": 3.52,
          "b": 3.52,
          "c": 3.52,
          "alpha": 90.0,
          "beta": 90.0,
          "gamma": 90.0,
          "unit": "angstrom_degree"
        }
      },
      "input": {
        "euler_deg": [
          [0.0, 0.0, 0.0],
          [45.0, 35.0, 10.0],
          [90.0, 45.0, 0.0]
        ],
        "specimen_direction": "ND",
        "saturation_gamma": 0.5
      },
      "requested_outputs": [
        "rgb",
        "sector_reduced_directions",
        "crystal_directions"
      ],
      "tolerances": {
        "rgb_abs": 0.03,
        "vector_abs": 1e-10
      },
      "notes": [
        "Color tolerance is intentionally looser than orientation tolerance because MTEX color-key rendering conventions may differ slightly."
      ]
    },
    {
      "case_id": "hex_ipf_nd_colors_001",
      "status": "active",
      "operation_family": "ipf_color",
      "operation": "ipf_colors_from_euler",
      "phase": {
        "phase_id": "zr_hcp",
        "crystal_system": "hexagonal",
        "point_group": "6/mmm",
        "lattice_parameters": {
          "a": 3.23,
          "b": 3.23,
          "c": 5.15,
          "alpha": 90.0,
          "beta": 90.0,
          "gamma": 120.0,
          "unit": "angstrom_degree"
        }
      },
      "input": {
        "euler_deg": [
          [0.0, 0.0, 0.0],
          [30.0, 60.0, 15.0],
          [120.0, 20.0, 45.0]
        ],
        "specimen_direction": "ND",
        "saturation_gamma": 0.5
      },
      "requested_outputs": [
        "rgb",
        "sector_reduced_directions",
        "crystal_directions"
      ],
      "tolerances": {
        "rgb_abs": 0.03,
        "vector_abs": 1e-10
      },
      "notes": [
        "Hexagonal IPF color case with explicit 6/mmm symmetry."
      ]
    }
  ]
}
