# PyTex-side parity results: regenerated by scripts/generate_pytex_parity_campaign.py.
# Only the MTEX-side reference results and the campaign case files are canonical.
fixtures/mtex_parity/results/pytex/*/

# npm scratch file created by local tooling; PyTex has no JavaScript build.
/package.json

# Notebook and local editor artifacts
.ipynb_checkpoints/
.jupyter_cache/
.idea/
.vscode/

# OS-specific noise
Thumbs.db
.codex_previews/
.codex_presentation/
.playwright-cli/
.DS_Store
output/*.png
output/*.svg
output/**/*.png
output/**/*.svg
outputs/
inspection_outputs/
artifacts/inspection/
reports/inspection/
fixtures/visual_regression/*.svg
*.log
*.tmp
*.bak
.venv/

# Session-local agent tooling config
.claude/
performance_results.json
reconstruction_robustness.json

# Generated capability deck: a 3 MB self-contained HTML plus its rasters,
# rebuilt on demand from docs/presentations/generate/. Kept out of history.
docs/presentations/
.tmp_pytex_platform_deck/

# Local figure-inspection scratch pages
.fig_*.html

# Reference PDF corpus: a local working library, not a repository asset.
# New PDFs are never tracked - cite them by DOI in references/reference_index.md
# instead. (Eight PDFs predate this rule and remain tracked; gitignore does not
# untrack them, and removing them is a separate decision.)
references/*.pdf
